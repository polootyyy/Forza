<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Polootyyy.ViewModels"
             xmlns:models="clr-namespace:Polootyyy.Models"
             xmlns:helpers="clr-namespace:Polootyyy.Helpers"
             x:Class="Polootyyy.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Polootyyy - FH6 Trainer"
             BackgroundColor="#0D0D1A">

    <ContentPage.Resources>
        <helpers:LogLevelColorConverter x:Key="LogColor" />
        <helpers:BoolToColorConverter x:Key="BoolColor" />
        <helpers:BoolToTextConverter x:Key="BoolText" />

        <Color x:Key="BgDark">#0D0D1A</Color>
        <Color x:Key="BgCard">#12122A</Color>
        <Color x:Key="BgCardAlt">#16163A</Color>
        <Color x:Key="Accent">#FF2D55</Color>
        <Color x:Key="AccentBlue">#0A84FF</Color>
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextSecondary">#8E8E9A</Color>
        <Color x:Key="BorderColor">#1E1E3A</Color>

        <Style x:Key="Card" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
            <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="HasShadow" Value="False" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1" />
        </Style>

        <Style x:Key="CheatName" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="CheatDesc" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="HotkeyLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#4A4A6A" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- RGB WAVE BORDER OVERLAY -->
        <GraphicsView x:Name="RgbBorder"
                      Grid.RowSpan="3"
                      InputTransparent="True"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill" />

        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="#0A0A1E" Padding="24,14" ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="POLOOTYYY" FontSize="26" FontAttributes="Bold"
                           TextColor="#FF2D55" CharacterSpacing="3" />
                    <Label Text="FH6" FontSize="26" FontAttributes="Bold"
                           TextColor="White" CharacterSpacing="3" />
                </HorizontalStackLayout>
                <Label Text="{Binding StatusText}" FontSize="12" TextColor="#8E8E9A" Margin="0,2,0,0" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Button Text="ATTACH" Command="{Binding AttachCommand}"
                        IsEnabled="{Binding IsNotAttached}"
                        BackgroundColor="#FF2D55" TextColor="White"
                        CornerRadius="8" FontAttributes="Bold" FontSize="12"
                        Padding="18,10" CharacterSpacing="1" />
                <Button Text="DETACH" Command="{Binding DetachCommand}"
                        IsEnabled="{Binding IsAttached}"
                        BackgroundColor="#2A2A4A" TextColor="White"
                        CornerRadius="8" FontSize="12" Padding="18,10" />
                <Button Text="RESCAN" Command="{Binding RescanCommand}"
                        IsEnabled="{Binding IsAttached}"
                        BackgroundColor="#0A84FF" TextColor="White"
                        CornerRadius="8" FontSize="12" Padding="18,10" />
            </HorizontalStackLayout>
        </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" ColumnDefinitions="1.6*,*" Padding="14,10" ColumnSpacing="10">

            <!-- LEFT: CHEATS -->
            <ScrollView Grid.Column="0">
                <VerticalStackLayout Spacing="10">

                    <!-- CURRENCY -->
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="💰 CURRENCY" Style="{StaticResource SectionTitle}" />
                            <BoxView HeightRequest="1" Color="#1E1E3A" Margin="0,0,0,4" />

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Infinite Credits" Style="{StaticResource CheatName}" />
                                    <Label Text="999,999,999 CR" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+F1" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[0].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Infinite Wheelspins" Style="{StaticResource CheatName}" />
                                    <Label Text="999 spins" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+F2" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[1].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Infinite Super Spins" Style="{StaticResource CheatName}" />
                                    <Label Text="999 super spins" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+F3" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[2].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Infinite Forzathon" Style="{StaticResource CheatName}" />
                                    <Label Text="9,999 FP" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+F4" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[3].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- GAMEPLAY -->
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🎮 GAMEPLAY" Style="{StaticResource SectionTitle}" />
                            <BoxView HeightRequest="1" Color="#1E1E3A" Margin="0,0,0,4" />

                            <!-- Drift -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Drift Multiplier" Style="{StaticResource CheatName}" />
                                    <Label Text="Multiply drift score" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding DriftMultiplier, StringFormat='{0:F1}x'}"
                                           TextColor="#FF2D55" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Switch IsToggled="{Binding Cheats[5].IsEnabled}"
                                            OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Slider Minimum="1" Maximum="100" Value="{Binding DriftMultiplier}"
                                    MinimumTrackColor="#FF2D55" MaximumTrackColor="#1E1E3A" ThumbColor="#FF2D55" />

                            <!-- Speed -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Speed Multiplier" Style="{StaticResource CheatName}" />
                                    <Label Text="Boost vehicle speed" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding SpeedMultiplier, StringFormat='{0:F1}x'}"
                                           TextColor="#0A84FF" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Switch IsToggled="{Binding Cheats[4].IsEnabled}"
                                            OnColor="#0A84FF" ThumbColor="White" Scale="0.85" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Slider Minimum="1" Maximum="10" Value="{Binding SpeedMultiplier}"
                                    MinimumTrackColor="#0A84FF" MaximumTrackColor="#1E1E3A" ThumbColor="#0A84FF" />

                            <!-- Skill Points -->
                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Infinite Skill Points" Style="{StaticResource CheatName}" />
                                    <Label Text="999 SP" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+F7" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[6].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <!-- No Skill Break -->
                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="No Skill Break" Style="{StaticResource CheatName}" />
                                    <Label Text="Skills never break" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+Shift+F7" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[7].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- PROGRESSION -->
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="📈 PROGRESSION" Style="{StaticResource SectionTitle}" />
                            <BoxView HeightRequest="1" Color="#1E1E3A" Margin="0,0,0,4" />

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Max XP" Style="{StaticResource CheatName}" />
                                    <Label Text="Max level XP" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+F8" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[8].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Sell Factor" Style="{StaticResource CheatName}" />
                                    <Label Text="Multiply sell price" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding SellFactor, StringFormat='{0:F1}x'}"
                                           TextColor="#FFD60A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Switch IsToggled="{Binding Cheats[9].IsEnabled}"
                                            OnColor="#FFD60A" ThumbColor="White" Scale="0.85" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Slider Minimum="1" Maximum="100" Value="{Binding SellFactor}"
                                    MinimumTrackColor="#FFD60A" MaximumTrackColor="#1E1E3A" ThumbColor="#FFD60A" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- UNLOCKS -->
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🔓 UNLOCKS" Style="{StaticResource SectionTitle}" />
                            <BoxView HeightRequest="1" Color="#1E1E3A" Margin="0,0,0,4" />

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Unlock All" Style="{StaticResource CheatName}" />
                                    <Label Text="Everything unlocked" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+F9" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[10].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="All Cars" Style="{StaticResource CheatName}" />
                                    <Label Text="Full car collection" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+F10" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[11].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Autoshow Unlock" Style="{StaticResource CheatName}" />
                                    <Label Text="All in autoshow" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+Shift+F9" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[12].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Free Cars" Style="{StaticResource CheatName}" />
                                    <Label Text="Cars cost 0 CR" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="Ctrl+Shift+F10" Style="{StaticResource HotkeyLabel}" />
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[13].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Free Upgrades" Style="{StaticResource CheatName}" />
                                    <Label Text="Upgrades cost 0 CR" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[14].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Hidden Cars" Style="{StaticResource CheatName}" />
                                    <Label Text="Reveal hidden cars" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[15].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Install Flags" Style="{StaticResource CheatName}" />
                                    <Label Text="All install flags" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[16].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,5">
                                <VerticalStackLayout>
                                    <Label Text="Clear New Tags" Style="{StaticResource CheatName}" />
                                    <Label Text="Remove NEW badges" Style="{StaticResource CheatDesc}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="2" IsToggled="{Binding Cheats[17].IsEnabled}"
                                        OnColor="#FF2D55" ThumbColor="White" Scale="0.85" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </ScrollView>

            <!-- RIGHT: LOG + RESET -->
            <VerticalStackLayout Grid.Column="1" Spacing="10">
                <Frame Style="{StaticResource Card}" Padding="0" VerticalOptions="FillAndExpand">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,12">
                            <Label Text="📋 EVENT LOG" Style="{StaticResource SectionTitle}" />
                            <Button Grid.Column="1" Text="CLEAR" Command="{Binding ClearLogCommand}"
                                    BackgroundColor="Transparent" TextColor="#FF2D55" FontSize="11" Padding="8,4" />
                        </Grid>

                        <CollectionView Grid.Row="1" ItemsSource="{Binding LogEntries}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:LogEntry">
                                    <VerticalStackLayout Padding="16,3">
                                        <Label TextColor="{Binding Level, Converter={StaticResource LogColor}}"
                                               FontSize="10" LineBreakMode="WordWrap">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}] '}"
                                                          TextColor="#3A3A5A" />
                                                    <Span Text="{Binding Message}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsScanning}"
                                           IsVisible="{Binding IsScanning}" Color="#FF2D55" Margin="0,6" />
                    </Grid>
                </Frame>

                <Button Text="🔄 EMERGENCY RESET ALL"
                        Command="{Binding ResetAllCommand}"
                        BackgroundColor="#2A1A1A" TextColor="#FF453A"
                        CornerRadius="10" FontAttributes="Bold" FontSize="12"
                        Padding="14,12" BorderColor="#FF453A" BorderWidth="1" />
            </VerticalStackLayout>

        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2" BackgroundColor="#0A0A1E" Padding="16,8">
            <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                <Label Text="POLOOTYYY FH6 Trainer v1.0" TextColor="#4A4A6A" FontSize="10" />
                <Label Text="|" TextColor="#2A2A4A" FontSize="10" />
                <Label Text="Forza Horizon 6" TextColor="#4A4A6A" FontSize="10" />
                <Label Text="|" TextColor="#2A2A4A" FontSize="10" />
                <Label Text="Run as Administrator" TextColor="#4A4A6A" FontSize="10" />
            </HorizontalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
